{
  "default": {
    "identifier": "default",
    "description": "Default permissions for DualCrypt Enterprise desktop application",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "dialog:default",
      "dialog:allow-open",
      "dialog:allow-save",
      "dialog:allow-message",
      "dialog:allow-ask",
